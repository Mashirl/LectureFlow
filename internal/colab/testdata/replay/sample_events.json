{
 "_source": "依据 borrow_run_release.json（上游 google-colab-cli 0.7.5 构造，非真实录制）加上 colab-obs-core 的远端采样：持有 BASE/sample.lock 的挂接进程先发 machine，再每 2 s 发 sample（字段见 internal/remote/sample.go），与讲座事件交错；磁盘模式，T4。",
 "upstream": {
  "package": "google-colab-cli",
  "version": "0.7.5",
  "files": [
   "colab_cli/client.py#Client.assign",
   "colab_cli/client.py#Client.list_assignments",
   "colab_cli/client.py#Client.unassign",
   "colab_cli/client.py#Client.get_consumption_user_info",
   "colab_cli/consumption.py#CcuInfo",
   "colab_cli/contents.py#ContentsClient",
   "colab_cli/runtime.py#ColabRuntime.execute_code",
   "colab_cli/commands/run.py#_teardown",
   "colab_cli/common.py#State.get_session",
   "jupyter-kernel-client 0.9.0 manager.py#KernelHttpManager.start_kernel",
   "jupyter-kernel-client 0.9.0 wsclient.py#KernelWebSocketClient.start_channels"
  ]
 },
 "recorded": false,
 "extends": "borrow_run_release.json",
 "until": "kernel channels: run colab_remote.py",
