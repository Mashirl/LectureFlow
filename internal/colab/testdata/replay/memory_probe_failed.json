{
 "_source": "依据 borrow_run_release.json 构造，非真实录制：内存探测单元格出错且没有输出，按磁盘模式继续，之后的请求与关闭内存模式时完全相同。",
 "upstream": {
  "package": "google-colab-cli",
  "version": "0.7.5",
  "files": [
   "colab_cli/runtime.py#ColabRuntime.execute_code"
  ]
 },
 "recorded": false,
 "extends": "borrow_run_release.json",
 "until": "mkdir content/lectureflow",
 "resume": "mkdir content/lectureflow",
 "steps": [
  {
   "name": "kernel channels: memory probe",
   "websocket": {
    "path": "/api/kernels/kernel-replay-1/channels",
    "query": {
     "session_id": "{{any}}",
     "token": "proxy-token-replay-1"
    },
    "headers": {
     "X-Colab-Runtime-Proxy-Token": "proxy-token-replay-1",
     "X-Colab-Client-Agent": "lectureflow"
    },
    "script": [
     {
      "expect": {
       "channel": "shell",
       "msg_type": "execute_request",
       "content_contains": {
        "code": "--memory-probe"
       },
       "content": {
        "silent": false,
        "store_history": false,
        "allow_stdin": false
       }
      }
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "status",
       "content": {
        "execution_state": "busy"
       }
      }
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "error",
       "content": {
        "ename": "TimeoutExpired",
        "evalue": "(the probe timed out)",
        "traceback": []
       }
      }
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "status",
       "content": {
        "execution_state": "idle"
       }
      }
     },
     {
      "send": {
       "channel": "shell",
       "msg_type": "execute_reply",
       "content": {
        "status": "error",
        "execution_count": 1,
        "user_expressions": {},
        "payload": []
       }
      }
     }
    ]
   }
  }
 ]
}
