{
 "_source": "依据 borrow_run_release.json（上游 google-colab-cli 0.7.5 的 contents.py、runtime.py、client.py 与 jupyter-kernel-client 0.9.0）与 worker/colab_remote.py 的内存探测契约（--memory-probe 的 memory 事件、memory 模式的 job.json）构造，非真实录制。内存模式（SPEC-ext“Colab 内存运行（实验）”）：上传之前先在内核里运行探测，探测选定的内存盘为 {{base}}，之后脚本、音频、job.json、结果与清理都在内存盘上。 3.2.0：成功后用内核里的一个单元格删除整个作业目录。",
 "upstream": {
  "package": "google-colab-cli",
  "version": "0.7.5",
  "files": [
   "colab_cli/contents.py#ContentsClient",
   "colab_cli/runtime.py#ColabRuntime.execute_code",
   "jupyter-kernel-client 0.9.0 wsclient.py#KernelWebSocketClient.start_channels"
  ]
 },
 "recorded": false,
 "extends": "borrow_run_release.json",
 "until": "mkdir content/lectureflow",
 "vars": {
  "base": "dev/shm/lectureflow"
 },
 "steps": [
  {
   "name": "kernel channels: memory probe",
   "websocket": {
    "path": "/api/kernels/kernel-replay-1/channels",
    "query": {
     "session_id": "{{any}}",
     "token": "proxy-token-replay-1"
    },
    "headers": {
     "X-Colab-Runtime-Proxy-Token": "proxy-token-replay-1",
     "X-Colab-Client-Agent": "lectureflow"
    },
    "script": [
     {
      "expect": {
       "channel": "shell",
       "msg_type": "execute_request",
       "content_contains": {
        "code": "--memory-probe"
       },
       "content": {
        "silent": false,
        "store_history": false,
        "allow_stdin": false
       }
      }
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "status",
       "content": {
        "execution_state": "busy"
       }
      }
     },
     {
      "stdout_lines": [
       {
        "type": "memory",
        "ts": 1793260799.0,
        "mode": "memory",
        "base": "/{{base}}",
        "reason": "ok",
        "mem_total_mb": 12985,
        "mem_available_mb": 11934,
        "need_mb": 11798,
        "free_mb": 9886
       }
      ]
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "status",
       "content": {
        "execution_state": "idle"
       }
      }
     },
     {
      "send": {
       "channel": "shell",
       "msg_type": "execute_reply",
       "content": {
        "status": "ok",
        "execution_count": 1,
        "user_expressions": {},
        "payload": []
       }
      }
     }
    ]
   }
  },
  {
   "name": "mkdir the RAM disk directory",
   "request": {
    "method": "PUT",
    "host": "runtime",
    "path": "/api/contents/{{base}}",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    },
    "json": {
     "type": "directory"
    }
   },
   "response": {
    "status": 201,
    "json": {
     "name": "lectureflow",
     "path": "{{base}}",
     "type": "directory"
    }
   }
  },
  {
   "name": "upload colab_remote.py",
   "request": {
    "method": "PUT",
    "host": "runtime",
    "path": "/api/contents/{{base}}/colab_remote.py",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    },
    "json": {
     "name": "colab_remote.py",
     "path": "{{base}}/colab_remote.py",
     "type": "file",
     "format": "base64",
     "content": "{{any}}",
     "chunk": 1
    }
   },
   "response": {
    "status": 201,
    "json": {
     "name": "colab_remote.py",
     "path": "{{base}}/colab_remote.py",
     "type": "file",
     "format": null
    }
   }
  },
  {
   "name": "upload asr.py",
   "request": {
    "method": "PUT",
    "host": "runtime",
    "path": "/api/contents/{{base}}/asr.py",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    },
    "json": {
     "name": "asr.py",
     "path": "{{base}}/asr.py",
     "type": "file",
     "format": "base64",
     "content": "{{any}}",
     "chunk": 1
    }
   },
   "response": {
    "status": 201,
    "json": {
     "name": "asr.py",
     "path": "{{base}}/asr.py",
     "type": "file",
     "format": null
    }
   }
  },
  {
   "name": "upload asr_common.py",
   "request": {
    "method": "PUT",
    "host": "runtime",
    "path": "/api/contents/{{base}}/asr_common.py",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    },
    "json": {
     "name": "asr_common.py",
     "path": "{{base}}/asr_common.py",
     "type": "file",
     "format": "base64",
     "content": "{{any}}",
     "chunk": 1
    }
   },
   "response": {
    "status": 201,
    "json": {
     "name": "asr_common.py",
     "path": "{{base}}/asr_common.py",
     "type": "file",
     "format": null
    }
   }
  },
  {
   "name": "upload textrepair.py",
   "request": {
    "method": "PUT",
    "host": "runtime",
    "path": "/api/contents/{{base}}/textrepair.py",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    },
    "json": {
     "name": "textrepair.py",
     "path": "{{base}}/textrepair.py",
     "type": "file",
     "format": "base64",
     "content": "{{any}}",
     "chunk": 1
    }
   },
   "response": {
    "status": 201,
    "json": {
     "name": "textrepair.py",
     "path": "{{base}}/textrepair.py",
     "type": "file",
     "format": null
    }
   }
  },
  {
   "name": "mkdir jobs",
   "request": {
    "method": "PUT",
    "host": "runtime",
    "path": "/api/contents/{{base}}/jobs",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    },
    "json": {
     "type": "directory"
    }
   },
   "response": {
    "status": 201,
    "json": {
     "name": "jobs",
     "path": "{{base}}/jobs",
     "type": "directory"
    }
   }
  },
  {
   "name": "mkdir the job directory",
   "request": {
    "method": "PUT",
    "host": "runtime",
    "path": "/api/contents/{{base}}/jobs/lecture-1",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    },
    "json": {
     "type": "directory"
    }
   },
   "response": {
    "status": 201,
    "json": {
     "name": "lecture-1",
     "path": "{{base}}/jobs/lecture-1",
     "type": "directory"
    }
   }
  },
  {
   "name": "kernel channels: run colab_remote.py",
   "websocket": {
    "path": "/api/kernels/kernel-replay-1/channels",
    "query": {
     "session_id": "{{any}}",
     "token": "proxy-token-replay-1"
    },
    "headers": {
     "X-Colab-Runtime-Proxy-Token": "proxy-token-replay-1",
     "X-Colab-Client-Agent": "lectureflow"
    },
    "script": [
     {
      "expect": {
       "channel": "shell",
       "msg_type": "execute_request",
       "content_contains": {
        "code": "'--attach'"
       },
       "content": {
        "silent": false,
        "store_history": false,
        "allow_stdin": false
       }
      }
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "status",
       "content": {
        "execution_state": "busy"
       }
      }
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "execute_input",
       "content": {
        "code": "(the cell)",
        "execution_count": 1
       }
      }
     },
     {
      "stdout_lines": [
       {
        "type": "stage",
        "ts": 1793260801.0,
        "stage": "install"
       }
      ]
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "stream",
       "parent": "other",
       "content": {
        "name": "stdout",
        "text": "output of another request: Zebrafish\n"
       }
      }
     },
     {
      "stdout_lines": [
       {
        "type": "stage",
        "ts": 1793260840.0,
        "stage": "download_model"
       },
       {
        "type": "stage",
        "ts": 1793260870.0,
        "stage": "load_model"
       }
      ]
     },
     {
      "after": "upload job.json"
     },
     {
      "stdout_lines": [
       {
        "type": "stage",
        "ts": 1793260880.0,
        "stage": "check"
       },
       {
        "type": "stage",
        "ts": 1793260883.0,
        "stage": "transcribe"
       },
       {
        "type": "progress",
        "ts": 1793260907.0,
        "fraction": 0.25
       }
      ]
     },
     {
      "stdout_raw": "{\"type\":\"progress\",\"ts\":1793260955.0,\"fra"
     },
     {
      "stdout_raw": "ction\":0.75}\n"
     },
     {
      "stdout_lines": [
       {
        "type": "progress",
        "ts": 1793260979.25,
        "fraction": 1.0
       },
       {
        "type": "stage",
        "ts": 1793260979.5,
        "stage": "write"
       },
       {
        "type": "done",
        "ts": 1793261000.0,
        "result": "result.json",
        "sha256": "{{sha256:result_json}}",
        "bytes": "{{len:result_json}}",
        "audio_s": 600.0,
        "load_s": 12.5,
        "transcribe_s": 96.25,
        "sentences": 1,
        "mem_peak_mb": 7310,
        "mem_total_mb": 12985
       }
      ]
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "stream",
       "content": {
        "name": "stderr",
        "text": "UserWarning: something about Zebrafish\n"
       }
      }
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "status",
       "content": {
        "execution_state": "idle"
       }
      }
     },
     {
      "send": {
       "channel": "shell",
       "msg_type": "execute_reply",
       "content": {
        "status": "ok",
        "execution_count": 1,
        "user_expressions": {},
        "payload": []
       }
      }
     }
    ]
   }
  },
  {
   "name": "upload audio chunk 1",
   "request": {
    "method": "PUT",
    "host": "runtime",
    "path": "/api/contents/{{base}}/jobs/lecture-1/audio.flac",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    },
    "json": {
     "name": "audio.flac",
     "path": "{{base}}/jobs/lecture-1/audio.flac",
     "type": "file",
     "format": "base64",
     "content": "{{any}}",
     "chunk": 1
    }
   },
   "response": {
    "status": 201,
    "json": {
     "name": "audio.flac",
     "path": "{{base}}/jobs/lecture-1/audio.flac",
     "type": "file",
     "format": null
    }
   }
  },
  {
   "name": "upload audio last chunk",
   "request": {
    "method": "PUT",
    "host": "runtime",
    "path": "/api/contents/{{base}}/jobs/lecture-1/audio.flac",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    },
    "json": {
     "name": "audio.flac",
     "path": "{{base}}/jobs/lecture-1/audio.flac",
     "type": "file",
     "format": "base64",
     "content": "{{any}}",
     "chunk": -1
    }
   },
   "response": {
    "status": 201,
    "json": {
     "name": "audio.flac",
     "path": "{{base}}/jobs/lecture-1/audio.flac",
     "type": "file",
     "format": null
    }
   }
  },
  {
   "name": "upload job.json",
   "request": {
    "method": "PUT",
    "host": "runtime",
    "path": "/api/contents/{{base}}/jobs/lecture-1/job.json",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    },
    "json": {
     "name": "job.json",
     "path": "{{base}}/jobs/lecture-1/job.json",
     "type": "file",
     "format": "base64",
     "content": "{{any}}",
     "chunk": 1
    }
   },
   "response": {
    "status": 201,
    "json": {
     "name": "job.json",
     "path": "{{base}}/jobs/lecture-1/job.json",
     "type": "file",
     "format": null
    }
   }
  },
  {
   "name": "download result",
   "request": {
    "method": "GET",
    "host": "runtime",
    "path": "/api/contents/{{base}}/jobs/lecture-1/result.json",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1",
     "content": "1",
     "format": "base64",
     "type": "file"
    }
   },
   "response": {
    "status": 200,
    "json": {
     "name": "result.json",
     "path": "{{base}}/jobs/lecture-1/result.json",
     "type": "file",
     "format": "base64",
     "mimetype": "application/json",
     "content": "{{b64:result_json}}"
    }
   }
  },
  {
   "name": "cleanup: remove the job directory in the kernel",
   "websocket": {
    "path": "/api/kernels/kernel-replay-1/channels",
    "query": {
     "session_id": "{{any}}",
     "token": "proxy-token-replay-1"
    },
    "headers": {
     "X-Colab-Runtime-Proxy-Token": "proxy-token-replay-1",
     "X-Colab-Client-Agent": "lectureflow"
    },
    "script": [
     {
      "expect": {
       "channel": "shell",
       "msg_type": "execute_request",
       "content_contains": {
        "code": "_lf_dir = \"/{{base}}/jobs/lecture-1\""
       },
       "content": {
        "silent": false,
        "store_history": false,
        "allow_stdin": false
       }
      }
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "status",
       "content": {
        "execution_state": "busy"
       }
      }
     },
     {
      "stdout_raw": "LECTUREFLOW_REMOVED\n"
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "status",
       "content": {
        "execution_state": "idle"
       }
      }
     },
     {
      "send": {
       "channel": "shell",
       "msg_type": "execute_reply",
       "content": {
        "status": "ok",
        "execution_count": 2,
        "user_expressions": {},
        "payload": []
       }
      }
     }
    ]
   }
  },
  {
   "name": "release: shut the kernel down",
   "request": {
    "method": "DELETE",
    "host": "runtime",
    "path": "/api/kernels/kernel-replay-1",
    "headers": {
     "Authorization": "Bearer proxy-token-replay-1",
     "X-Colab-Runtime-Proxy-Token": "proxy-token-replay-1",
     "X-Colab-Client-Agent": "lectureflow"
    }
   },
   "response": {
    "status": 204
   }
  },
  {
   "name": "release: GET /tun/m/assignments",
   "request": {
    "method": "GET",
    "host": "colab",
    "path": "/tun/m/assignments",
    "query": {
     "authuser": "0"
    },
    "headers": {
     "Authorization": "Bearer ya29.replay-access-token-1",
     "X-Colab-Client-Agent": "lectureflow",
     "Accept": "application/json"
    }
   },
   "response": {
    "status": 200,
    "xssi": true,
    "json": {
     "assignments": [
      {
       "accelerator": "T4",
       "endpoint": "gpu-t4-s-replay1",
       "variant": 1,
       "machineShape": 0,
       "runtimeProxyInfo": {
        "token": "proxy-token-replay-1",
        "tokenExpiresInSeconds": 3600,
        "url": "{{runtime_url}}"
       }
      }
     ]
    }
   }
  },
  {
   "name": "release: unassign GET (XSRF token)",
   "request": {
    "method": "GET",
    "host": "colab",
    "path": "/tun/m/unassign/gpu-t4-s-replay1",
    "query": {
     "authuser": "0"
    },
    "headers": {
     "Authorization": "Bearer ya29.replay-access-token-1",
     "X-Colab-Client-Agent": "lectureflow",
     "Accept": "application/json"
    }
   },
   "response": {
    "status": 200,
    "xssi": true,
    "json": {
     "token": "xsrf-unassign-replay-1"
    }
   }
  },
  {
   "name": "release: unassign POST",
   "request": {
    "method": "POST",
    "host": "colab",
    "path": "/tun/m/unassign/gpu-t4-s-replay1",
    "query": {
     "authuser": "0"
    },
    "headers": {
     "Authorization": "Bearer ya29.replay-access-token-1",
     "X-Colab-Client-Agent": "lectureflow",
     "Accept": "application/json",
     "X-Goog-Colab-Token": "xsrf-unassign-replay-1"
    }
   },
   "response": {
    "status": 200,
    "xssi": true,
    "json": {}
   }
  }
 ]
}
