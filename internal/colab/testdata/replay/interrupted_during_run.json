{
 "_source": "依据上游 google-colab-cli 0.7.5 的 colab_cli/commands/run.py run_command 的 finally（中断后 _teardown 释放运行时）构造，非真实录制：远端转写进行中被中断（内核通道由测试替身提供，不在样本中）；中断后不逐个删除远端文件，直接释放运行时。",
 "upstream": {
  "package": "google-colab-cli",
  "version": "0.7.5",
  "files": [
   "colab_cli/commands/run.py#run_command",
   "colab_cli/commands/run.py#_teardown"
  ]
 },
 "recorded": false,
 "extends": "borrow_run_release.json",
 "until": "kernel channels: run colab_remote.py",
 "steps": [
  {
   "name": "release: shut the kernel down",
   "request": {
    "method": "DELETE",
    "host": "runtime",
    "path": "/api/kernels/kernel-replay-1",
    "headers": {
     "Authorization": "Bearer proxy-token-replay-1",
     "X-Colab-Runtime-Proxy-Token": "proxy-token-replay-1",
     "X-Colab-Client-Agent": "lectureflow"
    }
   },
   "response": {
    "status": 204
   }
  },
  {
   "name": "release: GET /tun/m/assignments",
   "request": {
    "method": "GET",
    "host": "colab",
    "path": "/tun/m/assignments",
    "query": {
     "authuser": "0"
    },
    "headers": {
     "Authorization": "Bearer ya29.replay-access-token-1",
     "X-Colab-Client-Agent": "lectureflow",
     "Accept": "application/json"
    }
   },
   "response": {
    "status": 200,
    "xssi": true,
    "json": {
     "assignments": [
      {
       "accelerator": "T4",
       "endpoint": "gpu-t4-s-replay1",
       "variant": 1,
       "machineShape": 0,
       "runtimeProxyInfo": {
        "token": "proxy-token-replay-1",
        "tokenExpiresInSeconds": 3600,
        "url": "{{runtime_url}}"
       }
      }
     ]
    }
   }
  },
  {
   "name": "release: unassign GET (XSRF token)",
   "request": {
    "method": "GET",
    "host": "colab",
    "path": "/tun/m/unassign/gpu-t4-s-replay1",
    "query": {
     "authuser": "0"
    },
    "headers": {
     "Authorization": "Bearer ya29.replay-access-token-1",
     "X-Colab-Client-Agent": "lectureflow",
     "Accept": "application/json"
    }
   },
   "response": {
    "status": 200,
    "xssi": true,
    "json": {
     "token": "xsrf-unassign-replay-1"
    }
   }
  },
  {
   "name": "release: unassign POST",
   "request": {
    "method": "POST",
    "host": "colab",
    "path": "/tun/m/unassign/gpu-t4-s-replay1",
    "query": {
     "authuser": "0"
    },
    "headers": {
     "Authorization": "Bearer ya29.replay-access-token-1",
     "X-Colab-Client-Agent": "lectureflow",
     "Accept": "application/json",
     "X-Goog-Colab-Token": "xsrf-unassign-replay-1"
    }
   },
   "response": {
    "status": 200,
    "xssi": true,
    "json": {}
   }
  }
 ]
}
