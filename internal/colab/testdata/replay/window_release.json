{
 "_source": "依据上游 google-colab-cli 0.7.5 的 colab_cli/common.py State.get_session（代理令牌临近过期时经 list_assignments 刷新，TOKEN_REFRESH_MARGIN）与 colab_cli/commands/run.py _teardown（“The script may have outlived the proxy token”）构造，非真实录制：公平窗口用完，4 小时后释放运行时。",
 "upstream": {
  "package": "google-colab-cli",
  "version": "0.7.5",
  "files": [
   "colab_cli/common.py#State.get_session",
   "colab_cli/commands/run.py#_teardown"
  ]
 },
 "recorded": false,
 "extends": "borrow_run_release.json",
 "until": "release: shut the kernel down",
 "steps": [
  {
   "name": "refresh the access token again",
   "request": {
    "method": "POST",
    "host": "oauth",
    "path": "/token",
    "headers": {
     "Content-Type": "application/x-www-form-urlencoded"
    },
    "form": {
     "grant_type": "refresh_token",
     "client_id": "replay-client.apps.googleusercontent.com",
     "client_secret": "replay-client-secret-abcdef",
     "refresh_token": "1//replay-refresh-token-0123456789",
     "scope": "openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/colaboratory"
    }
   },
   "response": {
    "status": 200,
    "json": {
     "access_token": "ya29.replay-access-token-2",
     "expires_in": 3599,
     "scope": "openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/colaboratory",
     "token_type": "Bearer"
    }
   }
  },
  {
   "name": "release: refresh the proxy token (GET /tun/m/assignments)",
   "request": {
    "method": "GET",
    "host": "colab",
    "path": "/tun/m/assignments",
    "query": {
     "authuser": "0"
    },
    "headers": {
     "Authorization": "Bearer ya29.replay-access-token-2",
     "X-Colab-Client-Agent": "lectureflow",
     "Accept": "application/json"
    }
   },
   "response": {
    "status": 200,
    "xssi": true,
    "json": {
     "assignments": [
      {
       "accelerator": "T4",
       "endpoint": "gpu-t4-s-replay1",
       "variant": 1,
       "machineShape": 0,
       "runtimeProxyInfo": {
        "token": "proxy-token-replay-2",
        "tokenExpiresInSeconds": 3600,
        "url": "{{runtime_url}}"
       }
      }
     ]
    }
   }
  },
  {
   "name": "release: shut the kernel down (fresh proxy token)",
   "request": {
    "method": "DELETE",
    "host": "runtime",
    "path": "/api/kernels/kernel-replay-1",
    "headers": {
     "Authorization": "Bearer proxy-token-replay-2",
     "X-Colab-Runtime-Proxy-Token": "proxy-token-replay-2"
    }
   },
   "response": {
    "status": 204
   }
  },
  {
   "name": "release: GET /tun/m/assignments",
   "request": {
    "method": "GET",
    "host": "colab",
    "path": "/tun/m/assignments",
    "query": {
     "authuser": "0"
    },
    "headers": {
     "Authorization": "Bearer ya29.replay-access-token-2",
     "X-Colab-Client-Agent": "lectureflow",
     "Accept": "application/json"
    }
   },
   "response": {
    "status": 200,
    "xssi": true,
    "json": {
     "assignments": [
      {
       "accelerator": "T4",
       "endpoint": "gpu-t4-s-replay1",
       "variant": 1,
       "machineShape": 0,
       "runtimeProxyInfo": {
        "token": "proxy-token-replay-1",
        "tokenExpiresInSeconds": 3600,
        "url": "{{runtime_url}}"
       }
      }
     ]
    }
   }
  },
  {
   "name": "release: unassign GET (XSRF token)",
   "request": {
    "method": "GET",
    "host": "colab",
    "path": "/tun/m/unassign/gpu-t4-s-replay1",
    "query": {
     "authuser": "0"
    },
    "headers": {
     "Authorization": "Bearer ya29.replay-access-token-2",
     "X-Colab-Client-Agent": "lectureflow",
     "Accept": "application/json"
    }
   },
   "response": {
    "status": 200,
    "xssi": true,
    "json": {
     "token": "xsrf-unassign-replay-1"
    }
   }
  },
  {
   "name": "release: unassign POST",
   "request": {
    "method": "POST",
    "host": "colab",
    "path": "/tun/m/unassign/gpu-t4-s-replay1",
    "query": {
     "authuser": "0"
    },
    "headers": {
     "Authorization": "Bearer ya29.replay-access-token-2",
     "X-Colab-Client-Agent": "lectureflow",
     "Accept": "application/json",
     "X-Goog-Colab-Token": "xsrf-unassign-replay-1"
    }
   },
   "response": {
    "status": 200,
    "xssi": true,
    "json": {}
   }
  }
 ]
}
