{
 "_source": "依据上游 google-colab-cli 0.7.5 的 colab_cli/runtime.py ColabRuntime.execute_code 与 colab_cli/commands/run.py _exit_code_from_outputs 构造，非真实录制：远端 worker 报 error 事件（no_gpu）并以非零退出，单元格以 SystemExit 结束。",
 "upstream": {
  "package": "google-colab-cli",
  "version": "0.7.5",
  "files": [
   "colab_cli/runtime.py#ColabRuntime.execute_code",
   "colab_cli/commands/run.py#_exit_code_from_outputs"
  ]
 },
 "recorded": false,
 "extends": "borrow_run_release.json",
 "until": "kernel channels: run colab_remote.py",
 "steps": [
  {
   "name": "kernel channels: run colab_remote.py",
   "websocket": {
    "path": "/api/kernels/kernel-replay-1/channels",
    "query": {
     "session_id": "{{any}}",
     "token": "proxy-token-replay-1"
    },
    "headers": {
     "X-Colab-Runtime-Proxy-Token": "proxy-token-replay-1",
     "X-Colab-Client-Agent": "lectureflow"
    },
    "script": [
     {
      "expect": {
       "channel": "shell",
       "msg_type": "execute_request",
       "content_contains": {
        "code": "'--attach'"
       },
       "content": {
        "silent": false,
        "store_history": false,
        "allow_stdin": false
       }
      }
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "status",
       "content": {
        "execution_state": "busy"
       }
      }
     },
     {
      "stdout_lines": [
       {
        "type": "stage",
        "ts": 1793260801.0,
        "stage": "install"
       }
      ]
     },
     {
      "after": "upload job.json"
     },
     {
      "stdout_lines": [
       {
        "type": "error",
        "ts": 1793260830.0,
        "code": "no_gpu",
        "retryable": true
       }
      ]
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "error",
       "content": {
        "ename": "SystemExit",
        "evalue": "1",
        "traceback": []
       }
      }
     },
     {
      "send": {
       "channel": "iopub",
       "msg_type": "status",
       "content": {
        "execution_state": "idle"
       }
      }
     },
     {
      "send": {
       "channel": "shell",
       "msg_type": "execute_reply",
       "content": {
        "status": "error",
        "ename": "SystemExit",
        "evalue": "1",
        "traceback": []
       }
      }
     }
    ]
   }
  },
  {
   "name": "upload audio chunk 1",
   "request": {
    "method": "PUT",
    "host": "runtime",
    "path": "/api/contents/content/lectureflow/jobs/lecture-1/audio.flac",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    },
    "json": {
     "name": "audio.flac",
     "path": "content/lectureflow/jobs/lecture-1/audio.flac",
     "type": "file",
     "format": "base64",
     "content": "{{any}}",
     "chunk": 1
    }
   },
   "response": {
    "status": 201,
    "json": {
     "name": "audio.flac",
     "path": "content/lectureflow/jobs/lecture-1/audio.flac",
     "type": "file",
     "format": null
    }
   }
  },
  {
   "name": "upload audio last chunk",
   "request": {
    "method": "PUT",
    "host": "runtime",
    "path": "/api/contents/content/lectureflow/jobs/lecture-1/audio.flac",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    },
    "json": {
     "name": "audio.flac",
     "path": "content/lectureflow/jobs/lecture-1/audio.flac",
     "type": "file",
     "format": "base64",
     "content": "{{any}}",
     "chunk": -1
    }
   },
   "response": {
    "status": 201,
    "json": {
     "name": "audio.flac",
     "path": "content/lectureflow/jobs/lecture-1/audio.flac",
     "type": "file",
     "format": null
    }
   }
  },
  {
   "name": "upload job.json",
   "request": {
    "method": "PUT",
    "host": "runtime",
    "path": "/api/contents/content/lectureflow/jobs/lecture-1/job.json",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    },
    "json": {
     "name": "job.json",
     "path": "content/lectureflow/jobs/lecture-1/job.json",
     "type": "file",
     "format": "base64",
     "content": "{{any}}",
     "chunk": 1
    }
   },
   "response": {
    "status": 201,
    "json": {
     "name": "job.json",
     "path": "content/lectureflow/jobs/lecture-1/job.json",
     "type": "file",
     "format": null
    }
   }
  },
  {
   "name": "cleanup: delete audio.flac",
   "request": {
    "method": "DELETE",
    "host": "runtime",
    "path": "/api/contents/content/lectureflow/jobs/lecture-1/audio.flac",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    }
   },
   "response": {
    "status": 204
   },
   "group": "cleanup"
  },
  {
   "name": "cleanup: delete audio.wav",
   "request": {
    "method": "DELETE",
    "host": "runtime",
    "path": "/api/contents/content/lectureflow/jobs/lecture-1/audio.wav",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    }
   },
   "response": {
    "status": 404
   },
   "group": "cleanup"
  },
  {
   "name": "cleanup: delete job.json",
   "request": {
    "method": "DELETE",
    "host": "runtime",
    "path": "/api/contents/content/lectureflow/jobs/lecture-1/job.json",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    }
   },
   "response": {
    "status": 204
   },
   "group": "cleanup"
  },
  {
   "name": "cleanup: delete result.json",
   "request": {
    "method": "DELETE",
    "host": "runtime",
    "path": "/api/contents/content/lectureflow/jobs/lecture-1/result.json",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    }
   },
   "response": {
    "status": 204
   },
   "group": "cleanup"
  },
  {
   "name": "cleanup: delete result.json.tmp",
   "request": {
    "method": "DELETE",
    "host": "runtime",
    "path": "/api/contents/content/lectureflow/jobs/lecture-1/result.json.tmp",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    }
   },
   "response": {
    "status": 404
   },
   "group": "cleanup"
  },
  {
   "name": "cleanup: delete stderr.log",
   "request": {
    "method": "DELETE",
    "host": "runtime",
    "path": "/api/contents/content/lectureflow/jobs/lecture-1/stderr.log",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    }
   },
   "response": {
    "status": 204
   },
   "group": "cleanup"
  },
  {
   "name": "cleanup: delete events",
   "request": {
    "method": "DELETE",
    "host": "runtime",
    "path": "/api/contents/content/lectureflow/jobs/lecture-1/events",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    }
   },
   "response": {
    "status": 204
   },
   "group": "cleanup"
  },
  {
   "name": "cleanup: delete job.log",
   "request": {
    "method": "DELETE",
    "host": "runtime",
    "path": "/api/contents/content/lectureflow/jobs/lecture-1/job.log",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    }
   },
   "response": {
    "status": 204
   },
   "group": "cleanup"
  },
  {
   "name": "cleanup: delete the job directory",
   "request": {
    "method": "DELETE",
    "host": "runtime",
    "path": "/api/contents/content/lectureflow/jobs/lecture-1",
    "query": {
     "authuser": "0",
     "colab-runtime-proxy-token": "proxy-token-replay-1"
    }
   },
   "response": {
    "status": 204
   }
  },
  {
   "name": "release: shut the kernel down",
   "request": {
    "method": "DELETE",
    "host": "runtime",
    "path": "/api/kernels/kernel-replay-1",
    "headers": {
     "Authorization": "Bearer proxy-token-replay-1",
     "X-Colab-Runtime-Proxy-Token": "proxy-token-replay-1",
     "X-Colab-Client-Agent": "lectureflow"
    }
   },
   "response": {
    "status": 204
   }
  },
  {
   "name": "release: GET /tun/m/assignments",
   "request": {
    "method": "GET",
    "host": "colab",
    "path": "/tun/m/assignments",
    "query": {
     "authuser": "0"
    },
    "headers": {
     "Authorization": "Bearer ya29.replay-access-token-1",
     "X-Colab-Client-Agent": "lectureflow",
     "Accept": "application/json"
    }
   },
   "response": {
    "status": 200,
    "xssi": true,
    "json": {
     "assignments": [
      {
       "accelerator": "T4",
       "endpoint": "gpu-t4-s-replay1",
       "variant": 1,
       "machineShape": 0,
       "runtimeProxyInfo": {
        "token": "proxy-token-replay-1",
        "tokenExpiresInSeconds": 3600,
        "url": "{{runtime_url}}"
       }
      }
     ]
    }
   }
  },
  {
   "name": "release: unassign GET (XSRF token)",
   "request": {
    "method": "GET",
    "host": "colab",
    "path": "/tun/m/unassign/gpu-t4-s-replay1",
    "query": {
     "authuser": "0"
    },
    "headers": {
     "Authorization": "Bearer ya29.replay-access-token-1",
     "X-Colab-Client-Agent": "lectureflow",
     "Accept": "application/json"
    }
   },
   "response": {
    "status": 200,
    "xssi": true,
    "json": {
     "token": "xsrf-unassign-replay-1"
    }
   }
  },
  {
   "name": "release: unassign POST",
   "request": {
    "method": "POST",
    "host": "colab",
    "path": "/tun/m/unassign/gpu-t4-s-replay1",
    "query": {
     "authuser": "0"
    },
    "headers": {
     "Authorization": "Bearer ya29.replay-access-token-1",
     "X-Colab-Client-Agent": "lectureflow",
     "Accept": "application/json",
     "X-Goog-Colab-Token": "xsrf-unassign-replay-1"
    }
   },
   "response": {
    "status": 200,
    "xssi": true,
    "json": {}
   }
  }
 ]
}
