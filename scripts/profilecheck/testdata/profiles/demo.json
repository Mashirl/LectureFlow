{
  "schemaVersion": 1,
  "id": "demo",
  "version": "0.1.0",
  "name": "Demo Lectures",
  "maintainers": ["@lectureflow-tester"],
  "match": {
    "hosts": ["*.lectures.example.org"],
    "pathPattern": "^/watch/[^/]+$"
  },
  "session": { "idFrom": { "pathPattern": "^/watch/([^/]+)$" } },
  "lecture": { "title": { "selector": "h1.lecture-title" } },
  "tracks": [
    {
      "role": "primary-audio",
      "label": { "zh-CN": "主讲音频", "en": "Lecture audio" },
      "detect": { "urlPattern": "/media/[^/]+\\.m4a$", "kind": "audio", "format": "file" },
      "recommended": true
    }
  ],
  "request": { "sendReferer": true, "cookieUrls": [], "maxConnectionsPerFile": 4 },
  "fixtures": "fixtures/demo/"
}
