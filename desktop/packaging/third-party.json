{
  "_doc": "Third-party programs bundled into resources/bin by scripts/stage.js (SPEC-v3 V7, V10). Every download is pinned by URL and SHA-256 and verified before use; the cache is desktop/.cache (git-ignored). Keep packaging/licenses/binaries.json in step with this file.",
  "macos": {
    "_doc": "The minimum macOS of the app: electron-builder's mac.minimumSystemVersion (LSMinimumSystemVersion) and the deployment target (MACOSX_DEPLOYMENT_TARGET) of the binaries built here (ffmpeg, aria2c). It is the highest minimum of the parts: Electron 44 (Electron Framework LC_BUILD_VERSION minos 13.0, LSMinimumSystemVersion 13.0) and Go 1.27 (the linker's default, cmd/link/internal/ld/macho.go: 13.0); uv 0.13.1 needs 11.0. stage.js fails when a Mach-O file in resources/ needs a newer macOS. checked_with: the Electron major and Go minor version this was checked for (build.test.js fails when either changes, so the value is re-checked).",
    "minimum_system_version": "13.0",
    "checked_with": {
      "electron": "44",
      "go": "1.27"
    }
  },
  "release_sources": {
    "_doc": "The corresponding source of the GPL / LGPL programs in resources/bin (ffmpeg, aria2c) is attached to every GitHub release next to the installers (GPLv2 section 3, LGPL-2.1 section 4: equivalent access to the source from the same place). scripts/sources.js builds one tar per program and platform: the pinned upstream tarballs that build uses (the program's own source and its deps, verified by SHA-256), its build_scripts, README.txt and SHA256SUMS. A source_code entry is the release attachment itself (release_asset), a pinned tarball in the bundle, or says why it is not attached (not_attached).",
    "repository": "ShouldBeQuincy/LectureFlow",
    "asset": "LectureFlow-{version}-source-{bundle}.tar"
  },
